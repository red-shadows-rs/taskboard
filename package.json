    "typescript": "^5",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
