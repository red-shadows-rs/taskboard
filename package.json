{
  "name": "taskboard",
  "version": "4.2.3",
  "private": true,
  "description": "Professional task management system for teams and managers",
  "author": "Shadow-x78 - RED SHADOWS | RS",
  "license": "GPL-3.0-or-later",
  "overrides": {
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "dompurify": "^3.4.16",
    "postcss-selector-parser": "^7.1.6",
    "sprintf-js": "^1.1.3"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run format:check && npm run lint && npm run type-check",
    "check": "npm run format:check && npm run type-check && npm run lint && npm run check:comments && npm run check:versions && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:demo": "tsx src/db/demoSeed.ts",
    "check:comments": "bash scripts/check-comments.sh",
    "check:versions": "bash scripts/check-versions.sh",
    "set-version": "bash scripts/set-version.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
