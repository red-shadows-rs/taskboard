# ─────────────────────────────────────────────
# TaskBoard - Environment Variables
# https://github.com/red-shadows-rs/taskboard
# ─────────────────────────────────────────────

# Copy to `.env.local` (git-ignored) and set only what you need.

# ── Application ──

NODE_ENV=development

# ── Session Security ──

# Secret used to sign session cookies. Use a long random value.
SESSION_SECRET=your-secret-key-here

# ── Reverse Proxy ──

# Set to true only when TaskBoard runs behind a trusted reverse proxy that sets
# the X-Forwarded-For header. Enables correct client IP detection for rate limits.
TRUST_PROXY=false

# ── Local Translation (NLLB-200 via transformers.js) ──

# Enable automatic title and description translation (default: true).
TRANSLATION_ENABLED=true

# Directory holding the downloaded ONNX models (default: ./models).
# TRANSLATION_MODELS_DIR=./models
