# ─────────────────────────────────────────────
# TaskBoard - Environment Variables
# https://github.com/red-shadows-rs/taskboard
# ─────────────────────────────────────────────

# Copy to `.env.local` (git-ignored) and set only what you need.

# ── Application ──

NODE_ENV=production
PORT=3000
HOST_PORT=6001
HOSTNAME=0.0.0.0

# ── Session Security ──

# Secret used to sign session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=<SESSION_SECRET>

# ── Reverse Proxy ──

# Set to true only when TaskBoard runs behind a trusted reverse proxy that sets
# the X-Forwarded-For header. Enables correct client IP detection for rate limits.
TRUST_PROXY=false

# ── SQLite Database Storage ──

# Directory holding SQLite databases (default: ./data).
DATA_DIR=./data

# Specific path to production SQLite database (default: ./data/taskboard.sqlite).
DATABASE_PATH=./data/taskboard.sqlite
