# ─────────────────────────────────────────────
# Taskboard - Git Ignore Rules
# https://github.com/red-shadows-rs/taskboard
# ─────────────────────────────────────────────

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Build outputs ──
.next/
out/
build/
dist/

# ── Local Runtime Data & Databases ──
data/
databases/archive/
remote_data/
*.db
*.db-*
*.sqlite
*.sqlite-*
tmp/

# ── User uploads ──
uploads/

# ── Environment variables ──
.env
.env.local
.env.*.local

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editor artifacts ──
.vscode/
.idea/
*.swp
*.swo
*~
.kilo/

# ── OS files ──
.DS_Store
Thumbs.db

# ── TypeScript ──
*.tsbuildinfo
next-env.d.ts

# ── Vercel ──
.vercel

# ── Testing ──
coverage/
